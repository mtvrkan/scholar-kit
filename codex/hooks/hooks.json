{
  "description": "GENERATED by scripts/codex_sync.py from .claude/settings.json — do not edit. Scholar-Kit enforcement gates for Codex; each must be trusted once in /hooks before it runs.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .codex/hooks/codex_adapter.py ]; then python .codex/hooks/codex_adapter.py protect_data_files; fi",
            "commandWindows": "if exist .codex\\hooks\\codex_adapter.py python .codex\\hooks\\codex_adapter.py protect_data_files"
          }
        ]
      },
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .codex/hooks/codex_adapter.py ]; then python .codex/hooks/codex_adapter.py phase_gate; fi",
            "commandWindows": "if exist .codex\\hooks\\codex_adapter.py python .codex\\hooks\\codex_adapter.py phase_gate"
          }
        ]
      },
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .codex/hooks/codex_adapter.py ]; then python .codex/hooks/codex_adapter.py agent_write_scope; fi",
            "commandWindows": "if exist .codex\\hooks\\codex_adapter.py python .codex\\hooks\\codex_adapter.py agent_write_scope"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .codex/hooks/codex_adapter.py ]; then python .codex/hooks/codex_adapter.py template_supremacy_gate; fi",
            "commandWindows": "if exist .codex\\hooks\\codex_adapter.py python .codex\\hooks\\codex_adapter.py template_supremacy_gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .codex/hooks/codex_adapter.py ]; then python .codex/hooks/codex_adapter.py cite_warn; fi",
            "commandWindows": "if exist .codex\\hooks\\codex_adapter.py python .codex\\hooks\\codex_adapter.py cite_warn",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .codex/hooks/codex_adapter.py ]; then python .codex/hooks/codex_adapter.py session_status; fi",
            "commandWindows": "if exist .codex\\hooks\\codex_adapter.py python .codex\\hooks\\codex_adapter.py session_status"
          }
        ]
      }
    ]
  }
}
