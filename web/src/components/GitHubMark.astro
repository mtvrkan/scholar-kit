---
/**
 * GitHub’s mark — the one third-party logo on the site, on the one button
 * whose whole job is to say where the download comes from.
 *
 * It is deliberately not in `Icon.astro` with the other twenty-one, and the
 * reason is mechanical rather than tidy: every icon in that set is a 24×24
 * `stroke="currentColor"` outline drawn on `fill="none"`, and this is a solid
 * silhouette. A filled path inside a stroked set comes out as a hollow
 * octocat, or forces a per-icon exception on a set whose value is that it has
 * none.
 *
 * It is a component rather than two copies of a 700-character path because
 * there are two "get the kit" buttons on the page and for three rounds only
 * the hero’s had the mark — the same action, drawn two different ways, a
 * screen apart.
 */
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
